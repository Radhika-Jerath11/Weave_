{
  "info": {
    "_postman_id": "7b8f9a2e-4d3c-4e89-9a81-2c9e78df0112",
    "name": "Weave API Collection",
    "description": "Comprehensive API testing collection for Weave Kanban & Dependency Engine. Compatible with Postman and VS Code Thunder Client.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "authToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "boardId",
      "value": "",
      "type": "string"
    },
    {
      "key": "taskId",
      "value": "",
      "type": "string"
    },
    {
      "key": "inviteToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "User Signup",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Student Demo\",\n  \"email\": \"student.test@weave.dev\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/signup",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "signup"]
            }
          }
        },
        {
          "name": "User Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.token) {",
                  "  pm.collectionVariables.set('authToken', res.token);",
                  "  console.log('Saved authToken successfully');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"nitika@gmail.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Get Current User Profile",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Boards",
      "item": [
        {
          "name": "List All User Boards",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (Array.isArray(res) && res.length > 0) {",
                  "  pm.collectionVariables.set('boardId', res[0]._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/boards",
              "host": ["{{baseUrl}}"],
              "path": ["boards"]
            }
          }
        },
        {
          "name": "Create New Board",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Final Presentation Board\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/boards",
              "host": ["{{baseUrl}}"],
              "path": ["boards"]
            }
          }
        },
        {
          "name": "Get Board Details & Tasks",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/boards/{{boardId}}",
              "host": ["{{baseUrl}}"],
              "path": ["boards", "{{boardId}}"]
            }
          }
        },
        {
          "name": "Calculate Critical Path",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/boards/{{boardId}}/critical-path",
              "host": ["{{baseUrl}}"],
              "path": ["boards", "{{boardId}}", "critical-path"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Tasks & Dependencies",
      "item": [
        {
          "name": "Create Task on Board",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.task && res.task._id) {",
                  "  pm.collectionVariables.set('taskId', res.task._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Implement MVC Controllers\",\n  \"description\": \"Split routes from controller handlers\",\n  \"priority\": \"HIGH\",\n  \"dueDate\": \"2026-10-30\",\n  \"dependsOn\": []\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/boards/{{boardId}}/tasks",
              "host": ["{{baseUrl}}"],
              "path": ["boards", "{{boardId}}", "tasks"]
            }
          }
        },
        {
          "name": "Update Task Status (Engine Lock Enforced)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"inprogress\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/tasks/{{taskId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["tasks", "{{taskId}}", "status"]
            }
          }
        },
        {
          "name": "Set Task Dependencies (Cycle Detection Tested)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dependsOn\": []\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/tasks/{{taskId}}/dependencies",
              "host": ["{{baseUrl}}"],
              "path": ["tasks", "{{taskId}}", "dependencies"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Invitations & Collaboration",
      "item": [
        {
          "name": "Create Board Invitation",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"guptagauri9666@gmail.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/boards/{{boardId}}/invites",
              "host": ["{{baseUrl}}"],
              "path": ["boards", "{{boardId}}", "invites"]
            }
          }
        },
        {
          "name": "Preview Invitation Token (Public)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/invites/preview?token={{inviteToken}}",
              "host": ["{{baseUrl}}"],
              "path": ["invites", "preview"],
              "query": [
                { "key": "token", "value": "{{inviteToken}}" }
              ]
            }
          }
        },
        {
          "name": "Get My Pending Invites",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/invites/my-pending",
              "host": ["{{baseUrl}}"],
              "path": ["invites", "my-pending"]
            }
          }
        }
      ]
    }
  ]
}
