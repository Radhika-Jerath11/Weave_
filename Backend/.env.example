PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/weave?retryWrites=true&w=majority
JWT_SECRET=your_super_secret_jwt_key_here

# In local dev:
# CLIENT_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
# CLIENT_URL=http://127.0.0.1:5500

# In production (e.g. deployed on Vercel, Render, or Railway):
CLIENT_ORIGINS=https://your-frontend-domain.com,http://127.0.0.1:5500
CLIENT_URL=https://your-frontend-domain.com

# Email configuration for invitations (e.g. Gmail App Password or SendGrid):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
MAIL_FROM=Weave <your_email@gmail.com>
